From cd8270f60b198fa78639c3ae28ee8cf51bc7eef3 Mon Sep 17 00:00:00 2001
From: Stanley <stanley.chang@intel.com>
Date: Tue, 22 Sep 2026 15:03:46 +0800
Subject: [PATCH 087/122] media: max96717: fix MAX9295D dual-PHY lane maps

Use the correct lane-map nibble for each MAX9295D CSI input while keeping
single-PHY MAX96717 and MAX9295A programming unchanged.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 drivers/media/i2c/maxim-serdes/max96717.c | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/drivers/media/i2c/maxim-serdes/max96717.c b/drivers/media/i2c/maxim-serdes/max96717.c
index 20448f86..664584d6 100644
--- a/drivers/media/i2c/maxim-serdes/max96717.c
+++ b/drivers/media/i2c/maxim-serdes/max96717.c
@@ -1058,6 +1058,7 @@ static int max96717_init_phy(struct max_ser *ser,
 	unsigned int reg;
 	unsigned int mask;
 	unsigned int val;
+	unsigned int lane_map;
 	unsigned int i;
 	int ret;
 
@@ -1108,8 +1109,12 @@ static int max96717_init_phy(struct max_ser *ser,
 			return -EINVAL;
 	}
 
+	lane_map = val;
+	if (priv->info->num_phys > 1 && phy_id == 0)
+		lane_map = val >> 4;
+
 	ret = regmap_update_bits(priv->regmap, reg,
-				 mask, field_prep(mask, val));
+				 mask, field_prep(mask, lane_map));
 	if (ret)
 		return ret;
 
@@ -1128,8 +1133,12 @@ static int max96717_init_phy(struct max_ser *ser,
 			return -EINVAL;
 	}
 
+	lane_map = val >> 4;
+	if (priv->info->num_phys > 1 && phy_id == 1)
+		lane_map = val & GENMASK(3, 0);
+
 	ret = regmap_update_bits(priv->regmap, reg,
-				 mask, field_prep(mask, val >> 4));
+				 mask, field_prep(mask, lane_map));
 	if (ret)
 		return ret;
 
-- 
