From 8c073f3dd11dd259f33cff9bded42745a5bcae04 Mon Sep 17 00:00:00 2001
From: florent pirou <florent.pirou@intel.com>
Date: Mon, 31 Aug 2026 11:15:10 -0700
Subject: [PATCH 074/122] makefile: compile d4xx-compat on skip maxim-serdes

* makefile: avoid colission between intel-lts linux tree based image

Signed-off-by: florent pirou <florent.pirou@intel.com>
---
 Makefile | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/Makefile b/Makefile
index b10f118e..61d75a07 100644
--- a/Makefile
+++ b/Makefile
@@ -31,9 +31,11 @@ KERNEL_EQ_7_0 := $(shell ([ $(KERNEL_VERSION) -eq 7 ] && [ $(KERNEL_PATCHLEVEL)
 KERNEL_GE_6_17 := $(shell ([ $(KERNEL_VERSION) -gt 6 ] || ([ $(KERNEL_VERSION) -eq 6 ] && [ $(KERNEL_PATCHLEVEL) -ge 17 ])) && echo 1 || echo 0)
 
 # Set for Intel BKC kernels that should skip maxim-serdes.
-KERNEL_IS_6_12_INTEL := $(shell ([ $(KERNEL_VERSION) -eq 6 ] && [ $(KERNEL_PATCHLEVEL) -eq 12 ] && echo $(KERNELRELEASE) | grep -q -- '-intel') && echo 1 || echo 0)
-KERNEL_IS_6_17_INTEL := $(shell ([ $(KERNEL_VERSION) -eq 6 ] && [ $(KERNEL_PATCHLEVEL) -eq 17 ] && echo $(KERNELRELEASE) | grep -q -- '-intel') && echo 1 || echo 0)
-KERNEL_SKIP_MAXIM_SERDES := $(shell ([ $(KERNEL_IS_6_12_INTEL) -eq 1 ] || [ $(KERNEL_IS_6_17_INTEL) -eq 1 ]) && echo 1 || echo 0)
+KERNEL_IS_6_12_INTEL_BKC := $(shell ([ $(KERNEL_VERSION) -eq 6 ] && [ $(KERNEL_PATCHLEVEL) -eq 12 ] && echo $(KERNELRELEASE) | grep -q -- '-intel') && echo 1 || echo 0)
+KERNEL_IS_6_17_INTEL_BKC := $(shell ([ $(KERNEL_VERSION) -eq 6 ] && [ $(KERNEL_PATCHLEVEL) -eq 17 ] && echo $(KERNELRELEASE) | grep -q -- '-intel') && echo 1 || echo 0)
+KERNEL_IS_6_12_INTEL_LTS := $(shell ([ $(KERNEL_VERSION) -eq 6 ] && [ $(KERNEL_PATCHLEVEL) -eq 12 ] && echo $(KERNELRELEASE) | grep -q -- '-intel-ese-experimental-lts') && echo 1 || echo 0)
+KERNEL_IS_6_17_INTEL_LTS := $(shell ([ $(KERNEL_VERSION) -eq 6 ] && [ $(KERNEL_PATCHLEVEL) -eq 17 ] && echo $(KERNELRELEASE) | grep -q -- '-intel-ese-experimental-lts') && echo 1 || echo 0)
+KERNEL_SKIP_MAXIM_SERDES := $(shell ([ $(SKIP_MAXIM_SERDES) -eq 1 ] || [[ $(KERNEL_IS_6_12_INTEL_BKC) -eq 1 ] && [ $(KERNEL_IS_6_12_INTEL_LTS) -eq 0 ]] || [[ $(KERNEL_IS_6_17_INTEL_BKC) -eq 1 ] && [ $(KERNEL_IS_6_17_INTEL_LTS) -eq 0 ]]) && echo 1 || echo 0)
 
 export EXTERNAL_BUILD = 1
 export CONFIG_IPU_BRIDGE=m
@@ -57,16 +59,16 @@ export CONFIG_INTEL_IPU_ACPI=m
 # rebuild that kernel with CONFIG_I2C_ATR=y to use maxim-serdes.
 # Skip only on 6.17-intel in this block.
 # 6.18-intel is allowed (WIP in BKC to enable CONFIG_I2C_ATR).
-ifeq ($(KERNEL_GE_6_17),1)
 ifneq ($(KERNEL_SKIP_MAXIM_SERDES),1)
+ifeq ($(KERNEL_GE_6_17),1)
 export CONFIG_VIDEO_MAXIM_SERDES=m
 export CONFIG_VIDEO_MAX96717=m
 export CONFIG_VIDEO_MAX96724=m
 export CONFIG_VIDEO_MAX9296A=m
-endif
-endif
-export CONFIG_MEDIA_CONTROLLER=m
 export CONFIG_VIDEO_D4XX=m
+export CONFIG_MEDIA_CONTROLLER=m
+endif
+else
 export CONFIG_INTEL_IPU_VC_EXT=y
 export CONFIG_VIDEO_D4XX_MAX9295_VC_EXT = n
 export CONFIG_VIDEO_D4XX_MAX967XX_DT_VC_EXT = y
@@ -74,6 +76,7 @@ export CONFIG_VIDEO_D4XX_MAX9295 = m
 export CONFIG_VIDEO_D4XX_MAX9296 = m
 export CONFIG_VIDEO_D4XX_COMPAT=m
 export CONFIG_VIDEO_D4XX_MAX96724 = m
+endif
 
 # Define config macros for conditional compilation in ipu-acpi.c
 # IS_ENABLED() checks for CONFIG_XXX or CONFIG_XXX_MODULE
-- 
2.43.0

