From ea952e36b459ba08cf12992390b111bc99ea069a Mon Sep 17 00:00:00 2001
From: Florent Pirou <florent.pirou@intel.com>
Date: Sat, 15 Jun 2024 02:29:27 +0800
Subject: [PATCH 19/80] d4xx-compat: ignore DS5_CAMERA_CID_HWMC_RW empty data
 ioctl

Signed-off-by: Florent Pirou <florent.pirou@intel.com>
---
 drivers/media/i2c/d4xx-compat/d4xx.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/media/i2c/d4xx-compat/d4xx.c b/drivers/media/i2c/d4xx-compat/d4xx.c
index d1ef3fbc..7a1c06ab 100644
--- a/drivers/media/i2c/d4xx-compat/d4xx.c
+++ b/drivers/media/i2c/d4xx-compat/d4xx.c
@@ -1,3 +1,4 @@
+
 // SPDX-License-Identifier: GPL-2.0
 /*
  * ds5.c - Intel(R) RealSense(TM) D4XX camera driver
@@ -2670,6 +2671,15 @@ static int ds5_g_volatile_ctrl(struct v4l2_ctrl *ctrl)
 			u16 dataLen = 0;
 			u16 bufLen = ctrl->dims[0];
 			ret = ds5_get_hwmc(state, data,	bufLen, &dataLen);
+			/* ignore empty data calls */
+			if (!dataLen) {
+				dev_dbg(sensor->sd.dev,
+				  "%s(): DS5_CAMERA_CID_HWMC_RW empty call "
+				  " Len: %d (ret: %x)\n",
+				  __func__, dataLen, ret);
+				ret = 0;
+				break;
+			}
 			if (ret)
 				break;
 			/* This is needed for librealsense, to align there code with UVC,
-- 
