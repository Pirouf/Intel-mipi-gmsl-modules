 		.hid_name = "INTC10CD",
 		.real_driver = D457_NAME,
 		.get_platform_data = get_sensor_pdata,
diff --git a/include/media/ipu-acpi-pdata.h b/include/media/ipu-acpi-pdata.h
index cc19ba63..368d038a 100644
--- a/include/media/ipu-acpi-pdata.h
+++ b/include/media/ipu-acpi-pdata.h
@@ -8,6 +8,10 @@
 #include <media/v4l2-mediabus.h>
 #include <media/serdes-pdata.h>
 
+#if IS_ENABLED(CONFIG_VIDEO_D4XX)
+#include <media/i2c/d4xx_pdata.h>
+#endif
+
 #define CL_EMPTY 0
 #define CL_DISCRETE 1
 #define CL_LT 5
