         ControllerInitiated,    // SlaveMode
         0x00061A80,             // ConnectionSpeed
         AddressingMode7Bit,     // AddressingMode
@@ -59,7 +78,6 @@ Name (_DSD, Package ()          // _DSD: Device-Specific Data
     Package ()
     {
         Package () { "mipi-img-clock-frequency", 96000000 }, // 96 MHz
-
