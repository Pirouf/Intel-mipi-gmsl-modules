From 42d4a9a7aaf098e6d08ce72cfb1ea0ef343fc819 Mon Sep 17 00:00:00 2001
From: florent pirou <florent.pirou@intel.com>
Date: Sat, 12 Sep 2026 06:56:27 +0800
Subject: [PATCH 080/122] acpi: initial ar0234 mono and stereo config

* add max9295d support
* add FSYNC extras ACPI parameters

Signed-off-by: florent pirou <florent.pirou@intel.com>
---
 acpi/ipu7/_cam_common_ar0234.asl              |  39 +++-
 acpi/ipu7/_des_ch_common_zedx.asl             | 113 +++++++++
 acpi/ipu7/_ser_common_max9295d.asl            | 214 ++++++++++++++++++
 acpi/ipu7/max96724-cexd-intrbl_sl_ar0234.asl  | 119 ++++++++++
 .../max96724-cexd-intrbl_sl_ar0234_stereo.asl | 138 +++++++++++
 .../max96724-servoss_sl_ar0234_stereo.asl     | 116 ++++++++++
 6 files changed, 735 insertions(+), 4 deletions(-)
 create mode 100644 acpi/ipu7/_des_ch_common_zedx.asl
 create mode 100644 acpi/ipu7/_ser_common_max9295d.asl
 create mode 100644 acpi/ipu7/max96724-cexd-intrbl_sl_ar0234.asl
 create mode 100644 acpi/ipu7/max96724-cexd-intrbl_sl_ar0234_stereo.asl
 create mode 100644 acpi/ipu7/max96724-servoss_sl_ar0234_stereo.asl

