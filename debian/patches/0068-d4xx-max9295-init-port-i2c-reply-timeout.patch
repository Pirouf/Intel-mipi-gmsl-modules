From 76aad4980c196d7cadae5e46e375eb01626abac4 Mon Sep 17 00:00:00 2001
From: florent pirou <florent.pirou@intel.com>
Date: Tue, 21 Jul 2026 12:22:39 -0700
Subject: [PATCH 68/80] d4xx-max9295: init port i2c reply timeout

Signed-off-by: florent pirou <florent.pirou@intel.com>
---
 drivers/media/i2c/d4xx-compat/d4xx-max9295.c | 83 ++++++++++++++++++++
 1 file changed, 83 insertions(+)

diff --git a/drivers/media/i2c/d4xx-compat/d4xx-max9295.c b/drivers/media/i2c/d4xx-compat/d4xx-max9295.c
index ad07d98a..1dcdb175 100644
--- a/drivers/media/i2c/d4xx-compat/d4xx-max9295.c
+++ b/drivers/media/i2c/d4xx-compat/d4xx-max9295.c
@@ -26,6 +26,13 @@
 #include <linux/version.h>
 #include <media/i2c/d4xx-max9295.h>
 
+#include <linux/bitops.h>
+#include <linux/bitfield.h>
+#define MAX9295_FIELD_PREP(_mask, _val)					\
+	({								\
+		((typeof(_mask))(_val) << __bf_shf(_mask)) & (_mask);	\
+	})
+
 /* register specifics */
 #define MAX9295_MIPI_RX0_ADDR 0x330
 #define MAX9295_MIPI_RX1_ADDR 0x331
@@ -45,9 +52,30 @@
 #define MAX9295_PIPE_EN_ADDR 0x2
 #define MAX9295_CSI_PORT_SEL_ADDR 0x308
 
+#define MAX9295_I2C0_ADDR 0x40
+#define MAX9295_I2C1_ADDR 0x41
 #define MAX9295_I2C4_ADDR 0x44
 #define MAX9295_I2C5_ADDR 0x45
 
+#define MAX9295_I2C_PT_0_ADDR 0x4C
+#define MAX9295_I2C_PT_1_ADDR 0x4D
+
+#define MAX9295_CC_SLV_SH_ADDR MAX9295_I2C0_ADDR
+#define MAX9295_CC_MST_BT_ADDR MAX9295_I2C1_ADDR
+#define MAX9295_CC_SLV_SH_PT_ADDR MAX9295_I2C_PT_0_ADDR
+#define MAX9295_CC_MST_BT_PT_ADDR MAX9295_I2C_PT_1_ADDR
+
+#define MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD GENMASK(2, 0)
+#define MAX9295_CC_I2C_REPLY_TIMEOUT_4MS 0x3
+#define MAX9295_CC_I2C_REPLY_TIMEOUT_16MS 0x6
+#define MAX9295_CC_I2C_SLV_SPEEDMODE_FIELD GENMASK(5, 4)
+#define MAX9295_CC_I2C_MST_SPEEDMODE_FIELD GENMASK(6, 4)
+#define MAX9295_CC_I2C_MST_BITRATE_100KHZ 0x2
+#define MAX9295_CC_I2C_MST_BITRATE_400KHZ 0x5
+#define MAX9295_CC_I2C_SLV_FASTMODEPLUS 0x0
+#define MAX9295_CC_I2C_SLV_FASTMODE 0x1
+#define MAX9295_CC_I2C_SLV_STDMODE 0x2
+
 #define MAX9295_DEV_ADDR 0x00
 
 #define MAX9295_LINK_STATUS_ADDR 0x13
@@ -873,6 +901,61 @@ int max9295_init_settings(struct device *dev)
 						  GMSL_CSI_DT_EMBED, i);
 	}
 
+#if defined(CONFIG_VIDEO_D4XX_MAX96724) || defined(CONFIG_VIDEO_D4XX_MAX96712)
+#ifdef CONFIG_VIDEO_D4XX_I2C_FASTMODE
+	/* initialize GMSL i2c fast-mode 400khz
+	*/
+	err = MAX9295_UPDATE_BITS(priv->regmap, MAX9295_CC_SLV_SH_ADDR,
+			   MAX9295_CC_I2C_SLV_SPEEDMODE_FIELD
+			   | MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD,
+			   MAX9295_FIELD_PREP(MAX9295_CC_I2C_SLV_SPEEDMODE_FIELD, MAX9295_CC_I2C_SLV_FASTMODEPLUS)
+			   | MAX9295_FIELD_PREP(MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD, MAX9295_CC_I2C_REPLY_TIMEOUT_4MS));
+	err |= MAX9295_UPDATE_BITS(priv->regmap, MAX9295_CC_MST_BT_ADDR,
+			   MAX9295_CC_I2C_MST_SPEEDMODE_FIELD
+			   | MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD,
+			   MAX9295_FIELD_PREP(MAX9295_CC_I2C_MST_SPEEDMODE_FIELD, MAX9295_CC_I2C_MST_BITRATE_400KHZ)
+			   | MAX9295_FIELD_PREP(MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD, MAX9295_CC_I2C_REPLY_TIMEOUT_4MS));
+	err |= MAX9295_UPDATE_BITS(priv->regmap, MAX9295_CC_SLV_SH_PT_ADDR,
+			   MAX9295_CC_I2C_SLV_SPEEDMODE_FIELD
+			   | MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD,
+			   MAX9295_FIELD_PREP(MAX9295_CC_I2C_SLV_SPEEDMODE_FIELD, MAX9295_CC_I2C_SLV_FASTMODEPLUS)
+			   | MAX9295_FIELD_PREP(MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD, MAX9295_CC_I2C_REPLY_TIMEOUT_4MS));
+	err |= MAX9295_UPDATE_BITS(priv->regmap, MAX9295_CC_MST_BT_PT_ADDR,
+			   MAX9295_CC_I2C_MST_SPEEDMODE_FIELD
+			   | MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD,
+			   MAX9295_FIELD_PREP(MAX9295_CC_I2C_MST_SPEEDMODE_FIELD, MAX9295_CC_I2C_MST_BITRATE_400KHZ)
+			   | MAX9295_FIELD_PREP(MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD, MAX9295_CC_I2C_REPLY_TIMEOUT_4MS));
+#else
+	/* initialize GMSL i2c standard-mode 400khz
+	*/
+	err = MAX9295_UPDATE_BITS(priv->regmap, MAX9295_CC_SLV_SH_ADDR,
+			   MAX9295_CC_I2C_SLV_SPEEDMODE_FIELD
+			   | MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD,
+			   MAX9295_FIELD_PREP(MAX9295_CC_I2C_SLV_SPEEDMODE_FIELD, MAX9295_CC_I2C_SLV_STDMODE)
+			   | MAX9295_FIELD_PREP(MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD, MAX9295_CC_I2C_REPLY_TIMEOUT_4MS));
+	err |= MAX9295_UPDATE_BITS(priv->regmap, MAX9295_CC_MST_BT_ADDR,
+			   MAX9295_CC_I2C_MST_SPEEDMODE_FIELD
+			   | MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD,
+			   MAX9295_FIELD_PREP(MAX9295_CC_I2C_MST_SPEEDMODE_FIELD, MAX9295_CC_I2C_MST_BITRATE_400KHZ)
+			   | MAX9295_FIELD_PREP(MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD, MAX9295_CC_I2C_REPLY_TIMEOUT_4MS));
+	err |= MAX9295_UPDATE_BITS(priv->regmap, MAX9295_CC_SLV_SH_PT_ADDR,
+			   MAX9295_CC_I2C_SLV_SPEEDMODE_FIELD
+			   | MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD,
+			   MAX9295_FIELD_PREP(MAX9295_CC_I2C_SLV_SPEEDMODE_FIELD, MAX9295_CC_I2C_SLV_STDMODE)
+			   | MAX9295_FIELD_PREP(MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD, MAX9295_CC_I2C_REPLY_TIMEOUT_4MS));
+	err |= MAX9295_UPDATE_BITS(priv->regmap, MAX9295_CC_MST_BT_PT_ADDR,
+			   MAX9295_CC_I2C_MST_SPEEDMODE_FIELD
+			   | MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD,
+			   MAX9295_FIELD_PREP(MAX9295_CC_I2C_MST_SPEEDMODE_FIELD, MAX9295_CC_I2C_MST_BITRATE_400KHZ)
+			   | MAX9295_FIELD_PREP(MAX9295_CC_I2C_REPLY_TIMEOUT_FIELD, MAX9295_CC_I2C_REPLY_TIMEOUT_4MS));
+#endif
+	if (err) {
+	  dev_warn(dev, "%s: Failed to set i2c link speed-mode: %d\n",
+			__func__,
+			err);
+	}
+#endif
+
 	/* Double-Check GMSL link status after stream start configuration */
 	{
 		unsigned int link_status = 0;
-- 
2.25.1

