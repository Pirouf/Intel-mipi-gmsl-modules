 			(pipe_1_status & 0x02) ? "IN-SYNC " : "",
 			(pipe_1_status & 0x04) ? "LOST-SYNC " : "");
 		max96724_read_reg(dev, MAX96724_PIPE_X_STATUS_2_MAP_ADDR, &pipe_2_status);
