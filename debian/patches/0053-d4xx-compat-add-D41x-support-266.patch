Date: Wed, 27 Aug 2025 08:55:48 +0300
Subject: [PATCH 53/80] d4xx-compat: add D41x support (#266)

* Add D41x support
* Fix D41x resolutions
---
 drivers/media/i2c/d4xx-compat/d4xx.c | 224 ++++++++++++++++++++++++++-
 1 file changed, 222 insertions(+), 2 deletions(-)

diff --git a/drivers/media/i2c/d4xx-compat/d4xx.c b/drivers/media/i2c/d4xx-compat/d4xx.c
index 6b474aa5..395ad192 100644
--- a/drivers/media/i2c/d4xx-compat/d4xx.c
+++ b/drivers/media/i2c/d4xx-compat/d4xx.c
@@ -76,6 +76,7 @@
 #define DS5_FW_VERSION			0x030C
 #define DS5_FW_BUILD			0x030E
 #define DS5_DEVICE_TYPE			0x0310
+#define DS5_DEVICE_TYPE_D41X		7
 #define DS5_DEVICE_TYPE_D45X		6
 #define DS5_DEVICE_TYPE_D43X		5
 #define DS5_DEVICE_TYPE_D46X		4
@@ -802,15 +803,65 @@ static const u16 ds5_framerate_30 = 30;
 static const u16 ds5_framerate_15_30[] = {15, 30};
 
 static const u16 ds5_framerate_25 = 25;
