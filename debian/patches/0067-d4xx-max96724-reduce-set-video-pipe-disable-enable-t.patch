From 6ce6213bd6197b1eb2c0230fa58288a299849b1e Mon Sep 17 00:00:00 2001
From: florent pirou <florent.pirou@intel.com>
Date: Wed, 15 Jul 2026 08:59:50 -0700
Subject: [PATCH 67/80] d4xx-max96724: reduce set video pipe disable-enable
 transitions

Signed-off-by: florent pirou <florent.pirou@intel.com>
---
 drivers/media/i2c/d4xx-compat/d4xx-max96724.c | 18 ++++++++++--------
 1 file changed, 10 insertions(+), 8 deletions(-)

diff --git a/drivers/media/i2c/d4xx-compat/d4xx-max96724.c b/drivers/media/i2c/d4xx-compat/d4xx-max96724.c
index fb57b2fa..03724bd4 100644
--- a/drivers/media/i2c/d4xx-compat/d4xx-max96724.c
+++ b/drivers/media/i2c/d4xx-compat/d4xx-max96724.c
@@ -1767,20 +1767,20 @@ void max96724_reset_oneshot(struct device *dev, u32 src_link)
 
 		if (!priv->pipe[i].st_count)
 			continue;
-
+		/*
 		if (src_link != priv->pipe[i].src_link)
 			continue;
-
+		*/
 		st_count++;
 	}
 
 	if (st_count > 1) {
-		dev_warn(dev, "%s: ignore %s Link reset ctrl\n",
-			 __func__, max96724_get_link_name(src_link));
+		dev_warn(dev, "%s: ignore %s Link reset ctrl (stream count=%u) \n",
+			 __func__, max96724_get_link_name(src_link), st_count);
 		return;
 	}
 
-	/* disable each video pipe configuration corresponding to the reset link */
+	/* disable each video pipe configuration corresponding to the reset link
 	for (i = 0; i < MAX96724_MAX_PIPES; i++) {
 
 		if (src_link != priv->pipe[i].src_link)
@@ -1789,11 +1789,12 @@ void max96724_reset_oneshot(struct device *dev, u32 src_link)
 		dev_dbg(dev, "%s: disable %s video pipe %d\n",
 			__func__, max96724_get_link_name(src_link), i);
 
-		/* disable video pipe if is no longer used */
+		// disable video pipe if is no longer used 
 		err = MAX96724_UPDATE_BITS(priv->regmap, MAX96724_VIDEO_PIPE_EN_ADDR,
 				MAX96724_VIDEO_PIPE_EN_FIELD(i),
 				MAX96724_FIELD_PREP(MAX96724_VIDEO_PIPE_EN_FIELD(i), 0U));
 	}
+	*/
 
 	/* Re-Check GMSL link status after initial configuration */
 	{
@@ -2271,8 +2272,9 @@ static int __max96724_set_pipe_d4xx(struct device *dev, int pipe_id, u8 data_typ
 	 *
 	 * REG 0x00F4: Enable/disable Video Pipes
 	 *   Bit[3:0] = <pipe_id>: Enable Pipe X
-	 */
 	if (src_link_st_count > 1) {
+	 */
+	if (st_count < 2) {
 		for (i = 0; i < MAX96724_MAX_PIPES; i++) {
 			if (!priv->pipe[i].st_count)
 				continue;
@@ -2453,7 +2455,6 @@ static int __max96724_set_pipe_d4xx(struct device *dev, int pipe_id, u8 data_typ
 	 *
 	 * REG 0x00F4: Enable/disable Video Pipes
 	 *   Bit[3:0] = <pipe_id>: Enable Pipe X
-	 */
 	if (src_link_st_count > 1) {
 		for (i = 0; i < MAX96724_MAX_PIPES; i++) {
 			if (!priv->pipe[i].st_count)
@@ -2467,6 +2468,7 @@ static int __max96724_set_pipe_d4xx(struct device *dev, int pipe_id, u8 data_typ
 				MAX96724_FIELD_PREP(MAX96724_VIDEO_PIPE_EN_FIELD(i), 1U));
 		}
 	} else
+	 */
 		err |= MAX96724_UPDATE_BITS(priv->regmap, MAX96724_VIDEO_PIPE_EN_ADDR,
 			MAX96724_VIDEO_PIPE_EN_FIELD(_pipe_id),
 			MAX96724_FIELD_PREP(MAX96724_VIDEO_PIPE_EN_FIELD(_pipe_id), 1U));
-- 
