From d418ccae746b2b95f76ab2e68b4ab2d02da88e13 Mon Sep 17 00:00:00 2001
From: Dmitry Perchanov <dmitry.perchanov@intel.com>
Date: Thu, 21 Mar 2024 10:48:12 +0200
Subject: [PATCH 29/80] d4xx-max929x: add kernel 6.5 support

* max929x: backported kernel6 #3 https://github.com/dmipx/ipu6-drivers/commit/cd6786ff212285b1e4004360bddd995a9a30b280
* max929x: backported kernel6 #2  https://github.com/dmipx/ipu6-drivers/commit/6883c69e6630332c652ea152cdc8426bfc6b1231
* max929x: backported kernel6 https://github.com/dmipx/ipu6-drivers/commit/f5caff791a9600ea1d836efe81e211a3e8a105cd

Signed-off-by: Dmitry Perchanov <dmitry.perchanov@intel.com>
---
 drivers/media/i2c/d4xx-compat/max9295.c | 7 +++++++
 drivers/media/i2c/d4xx-compat/max9296.c | 9 +++++++--
 2 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/drivers/media/i2c/d4xx-compat/max9295.c b/drivers/media/i2c/d4xx-compat/max9295.c
index e0c06d1b..4e203af0 100644
--- a/drivers/media/i2c/d4xx-compat/max9295.c
+++ b/drivers/media/i2c/d4xx-compat/max9295.c
@@ -23,6 +23,7 @@
 #include <linux/media.h>
 #include <linux/module.h>
 #include <linux/regmap.h>
+#include <linux/version.h>
 #include <media/max9295.h>
 
 /* register specifics */
@@ -719,7 +720,11 @@ static int max9295_probe(struct i2c_client *client)
 	return err;
 }
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 1, 0)
 static int max9295_remove(struct i2c_client *client)
+#else
+static void max9295_remove(struct i2c_client *client)
+#endif
 {
 	struct max9295 *priv;
 
@@ -733,7 +738,9 @@ static int max9295_remove(struct i2c_client *client)
 #endif
 	}
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 1, 0)
 	return 0;
+#endif
 }
 
 static const struct i2c_device_id max9295_id[] = {
diff --git a/drivers/media/i2c/d4xx-compat/max9296.c b/drivers/media/i2c/d4xx-compat/max9296.c
index 42807262..45641eb6 100644
--- a/drivers/media/i2c/d4xx-compat/max9296.c
+++ b/drivers/media/i2c/d4xx-compat/max9296.c
@@ -24,6 +24,7 @@
 #include <linux/of.h>
 #include <linux/of_device.h>
 #include <linux/of_gpio.h>
+#include <linux/version.h>
 // #include <media/camera_common.h>
 #include <linux/regmap.h>
 #include <media/max9296.h>
@@ -1134,8 +1135,11 @@ static int max9296_probe(struct i2c_client *client)
 	return err;
 }
 
-
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 1, 0)
 static int max9296_remove(struct i2c_client *client)
+#else
+static void max9296_remove(struct i2c_client *client)
+#endif
 {
 	struct max9296 *priv;
 
@@ -1148,8 +1152,9 @@ static int max9296_remove(struct i2c_client *client)
 		client = NULL;
 #endif
 	}
-
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 1, 0)
 	return 0;
+#endif
 }
 
 static const struct i2c_device_id max9296_id[] = {
