#!/bin/sh
# postrm script for intel-mipi-gmsl-dkms
#
# see: dh_installdeb(1)

DKMS_PACKAGE_NAME=@DKMS_PACKAGE_NAME@

set -e

# summary of how this script can be called:
#        * <postrm> `remove'
#        * <postrm> `purge'
#        * <old-postrm> `upgrade' <new-version>
#        * <new-postrm> `failed-upgrade' <old-version>
#        * <new-postrm> `abort-install'
#        * <new-postrm> `abort-install' <old-version>
#        * <new-postrm> `abort-upgrade' <old-version>
#        * <disappearer's-postrm> `disappear' <overwriter>
#          <overwriter-version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
    purge)
	if [ "$1" = purge ] && [ -e /usr/share/debconf/confmodule ]; then
	    . /usr/share/debconf/confmodule

	    db_purge
	fi
	;;
    remove)
	if [ -e /usr/share/debconf/confmodule ]; then

	    . /usr/share/debconf/confmodule

	    db_get ${DKMS_PACKAGE_NAME}/max9x
	    MAX9X=${RET}
	    db_get ${DKMS_PACKAGE_NAME}/ipu
	    IPU=${RET}
	    db_get ${DKMS_PACKAGE_NAME}/board
	    BOARD=${RET}
	    db_get ${DKMS_PACKAGE_NAME}/sensor
	    SENSOR=${RET}

	    if [ -e /etc/default/grub.d/ssdt.cfg ]; then
		echo "clear /etc/default/grub.d/ssdt.cfg" >&2
		rm -f /etc/default/grub.d/ssdt.cfg
		if command -v update-grub > /dev/null && [ -d /boot/grub ]; then
		    if [ -e /boot/${IPU}_${BOARD}_${SENSOR}_ssdt.img ]; then
			echo "clear ACPI SSDT-overlay ${IPU}/${BOARD}_${SENSOR}.aml" >&2
			rm -f /boot/${IPU}_${BOARD}_${SENSOR}_ssdt.img || :
		    fi
		    update-grub || :
		fi
	    fi

	fi
	# avoid potential conflict with manually compiled dkms build
	if [ -d /var/lib/dkms/$DKMS_PACKAGE_NAME ]; then
	    echo "clear /var/lib/dkms/$DKMS_PACKAGE_NAME" >&2
	    rm -rf /var/lib/dkms/$DKMS_PACKAGE_NAME
	    rm -rf /usr/src/$DKMS_PACKAGE_NAME-*
	fi
	;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	# avoid potential conflict with manually compiled dkms build
	if [ -d /var/lib/dkms/$DKMS_PACKAGE_NAME ]; then
	    echo "clear /var/lib/dkms/$DKMS_PACKAGE_NAME" >&2
	    rm -rf /var/lib/dkms/$DKMS_PACKAGE_NAME
	    rm -rf /usr/src/$DKMS_PACKAGE_NAME-*
	fi
	;;

    *)
	echo "postrm called with unknown argument \`$1'" >&2
	exit 1
	;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
