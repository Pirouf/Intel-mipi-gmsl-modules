From 3057c38cbfc14be6a6d0c5fd7a602584fde9e027 Mon Sep 17 00:00:00 2001
From: Arun T <arun.t@intel.com>
Date: Wed, 16 Sep 2026 06:37:41 -0700
Subject: [PATCH 110/111] media:ipu7 add ipu psys node for debugfs

Signed-off-by: florent pirou <florent.pirou@intel.com>
---
 .../drivers/media/pci/intel/ipu7/psys/ipu-psys.c         | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/ipu7-drivers/drivers/media/pci/intel/ipu7/psys/ipu-psys.c b/ipu7-drivers/drivers/media/pci/intel/ipu7/psys/ipu-psys.c
index 6ae5598..a095a43 100644
--- a/ipu7-drivers/drivers/media/pci/intel/ipu7/psys/ipu-psys.c
+++ b/ipu7-drivers/drivers/media/pci/intel/ipu7/psys/ipu-psys.c
@@ -1309,8 +1309,11 @@ static int ipu7_psys_init_debugfs(struct ipu7_psys *psys)
 {
 	struct dentry *file;
 	struct dentry *dir;
-
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 17, 0)
 	dir = debugfs_create_dir("psys", psys->adev->isp->ipu7_dir);
+#else
+	dir = debugfs_create_dir("ipu7-psys", NULL);
+#endif
 	if (IS_ERR(dir))
 		return -ENOMEM;
 
@@ -1457,9 +1460,7 @@ static void ipu7_psys_remove(struct auxiliary_device *auxdev)
 	struct ipu7_psys *psys = dev_get_drvdata(&auxdev->dev);
 	struct device *dev = &auxdev->dev;
 #ifdef CONFIG_DEBUG_FS
-	struct ipu7_device *isp = psys->adev->isp;
-
-	if (isp->ipu7_dir)
+	if (psys->debugfsdir)
 		debugfs_remove_recursive(psys->debugfsdir);
 #endif
 
-- 
